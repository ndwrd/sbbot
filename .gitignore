/app/config.php
# Генерится один раз в start_php.sh (декой-заглушка nginx). Игнор нужен ещё и
# затем, чтобы `git clean -fd` в update/update.sh его не сносил при каждом
# обновлении: без -x clean не трогает игнорируемые файлы.
/app/webapp/.htpasswd
/certs/*
!/certs/.gitkeep
/logs/*
!/logs/.gitkeep
/ssh/*
!/ssh/.gitkeep
/app/zaprelists/*
!/app/zaprelists/.gitkeep
/sftp-config.json
/tg.pyr
/config/wg0.conf
/config/hwid.json
/config/pac.json
/config/mtprotosecret
/config/mtprotodomain
/config/deny
/config/singbox.stats
/config/sing-box/
/config/teleproxy/
/config/telemt/
/config/apps_cache.json
/todo.todo
.vscode/
.idea/
mirror/.env
update/*
!update/update.sh

override.env
override.html
override.php
docker-compose.override.yml
backup.json
app/override/*
!app/override/.gitkeep
.rest

subscription.override.php
apps.override.json
location.conf
override.conf
i18n.override.php