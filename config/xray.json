{
    "log": {
        "access": "",
        "error": "",
        "loglevel": "warning"
    },
    "dns": {
        "servers": [
            "fakedns",
            "https://1.1.1.1/dns-query",
            "https://8.8.8.8/dns-query"
        ]
    },
    "fakedns": {
        "ipPool": "198.18.0.0/15",
        "poolSize": 65535
    },
    "inbounds": [
        {
            "tag": "socks",
            "port": 10808,
            "listen": "127.0.0.1",
            "protocol": "socks",
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls", "quic", "fakedns"],
                "routeOnly": false
            },
            "settings": {
                "auth": "noauth",
                "udp": true,
                "allowTransparent": false
            }
        },
        {
            "tag": "http",
            "port": 10809,
            "listen": "127.0.0.1",
            "protocol": "http",
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls", "quic", "fakedns"],
                "routeOnly": false
            },
            "settings": {
                "auth": "noauth",
                "udp": true,
                "allowTransparent": false
            }
        }
    ],
    "outbounds": [
        {
            "tag": "direct",
            "protocol": "freedom"
        },
        {
            "tag": "dns-out",
            "protocol": "dns"
        },
        {
            "tag": "Proxy",
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "~domain~",
                        "port": 443,
                        "users": [
                            {
                                "id": "~uid~",
                                "alterId": 0,
                                "email": "t@t.tt",
                                "security": "auto",
                                "encryption": "none"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "ws",
                "security": "tls",
                "wsSettings": {
                    "path": "~wspath~?ed=2560"
                },
                "tlsSettings": {
                    "allowInsecure": false,
                    "serverName": "~domain~",
                    "fingerprint": "firefox"
                }
            }
        },
        {
            "tag": "HY2",
            "protocol": "hysteria",
            "settings": {
                "version": 2,
                "address": "~domain~",
                "port": 443
            },
            "streamSettings": {
                "network": "hysteria",
                "security": "tls",
                "tlsSettings": {
                    "serverName": "~domain~"
                },
                "hysteriaSettings": {
                    "version": 2,
                    "auth": "~password~",
                    "udpIdleTimeout": 60
                }
            }
        },
        {
            "tag": "block",
            "protocol": "blackhole",
            "settings": {
                "response": {
                    "type": "http"
                }
            }
        }
    ],
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {
                "type": "field",
                "outboundTag": "block",
                "domain": ["~block~", "geosite:category-ads-all"]
            },
            {
                "type": "field",
                "outboundTag": "block",
                "network": "udp",
                "port": "443"
            },
            {
                "type": "field",
                "outboundTag": "dns-out",
                "network": "udp",
                "port": "53"
            },
            {
                "type": "field",
                "outboundTag": "direct",
                "protocol": ["bittorrent"]
            },
            {
                "type": "field",
                "outboundTag": "direct",
                "domain": ["geosite:category-ru"]
            },
            {
                "type": "field",
                "outboundTag": "direct",
                "ip": ["geoip:private"]
            },
            {
                "type": "field",
                "outboundTag": "Proxy",
                "domain": [
                    "geosite:anthropic",
                    "geosite:github-copilot",
                    "geosite:google-gemini",
                    "geosite:meta",
                    "geosite:nintendo",
                    "geosite:twitter",
                    "geosite:mega",
                    "geosite:ookla-speedtest",
                    "geosite:openai",
                    "geosite:paypal",
                    "geosite:protonmail",
                    "geosite:signal",
                    "geosite:supercell",
                    "geosite:telegram",
                    "geosite:tiktok",
                    "geosite:tutanota",
                    "geosite:viber",
                    "geosite:youtube"
                ]
            },
            {
                "type": "field",
                "outboundTag": "Proxy",
                "domain": "~domains~"
            },
            {
                "type": "field",
                "outboundTag": "Proxy",
                "ip": "~subnet~"
            },
            {
                "type": "field",
                "outboundTag": "Proxy",
                "domain": "~warp~"
            },
            {
                "type": "field",
                "outboundTag": "direct",
                "network": "tcp,udp"
            }
        ]
    }
}
