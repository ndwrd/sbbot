{
    "log": {
        "level": "info",
        "output": "/logs/singbox.log"
    },
    "dns": {
        "servers": [
            {
                "tag": "default",
                "address": "local"
            }
        ]
    },
    "inbounds": [
        {
            "type": "vless",
            "tag": "vless-ws-in",
            "listen": "0.0.0.0",
            "listen_port": 443,
            "users": [],
            "tls": {
                "enabled": false
            },
            "transport": {
                "type": "ws",
                "path": "/ws"
            }
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct"
        },
        {
            "type": "block",
            "tag": "block"
        }
    ],
    "route": {
        "rules": []
    },
    "experimental": {
        "v2ray_api": {
            "listen": "127.0.0.1:8080",
            "stats": {
                "enabled": true,
                "inbounds": [
                    "vless-ws-in"
                ],
                "outbounds": [
                    "direct"
                ],
                "users": []
            }
        }
    }
}
