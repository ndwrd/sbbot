{
    "log": {
        "access": "",
        "error": "",
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "tag": "socks",
            "port": 10808,
            "listen": "127.0.0.1",
            "protocol": "socks",
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls"
                ],
                "routeOnly": false
            },
            "settings": {
                "auth": "noauth",
                "udp": true,
                "allowTransparent": false
            }
        },
        {
            "tag": "http",
            "port": 10809,
            "listen": "127.0.0.1",
            "protocol": "http",
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls"
                ],
                "routeOnly": false
            },
            "settings": {
                "auth": "noauth",
                "udp": true,
                "allowTransparent": false
            }
        }
    ],
    "outbounds": [
        {
            "tag": "direct",
            "protocol": "freedom"
        },
        {
            "tag": "~outbound~",
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "~domain~",
                        "port": 443,
                        "users": [
                            {
                                "id": "~uid~",
                                "alterId": 0,
                                "email": "t@t.tt",
                                "security": "auto",
                                "encryption": "none"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "ws",
                "security": "tls",
                "wsSettings": {
                    "path": "~wspath~?ed=2560"
                },
                "tlsSettings": {
                    "allowInsecure": false,
                    "serverName": "~domain~",
                    "fingerprint": "chrome"
                }
            }
        },
        {
            "tag": "block",
            "protocol": "blackhole",
            "settings": {
                "response": {
                    "type": "http"
                }
            }
        }
    ],
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
            {
                "type": "field",
                "outboundTag": "block",
                "domain": "~block~"
            },
            {
                "type": "field",
                "outboundTag": "~outbound~",
                "domain": "~domains~"
            },
            {
                "type": "field",
                "outboundTag": "~outbound~",
                "ip": "~subnet~"
            },
            {
                "type": "field",
                "outboundTag": "~outbound~",
                "domain": "~warp~"
            }
        ]
    }
}